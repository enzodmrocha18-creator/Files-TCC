matriz_B <- function(v) {
  U     <- resid(v)
  npar  <- ncol(v$datamat) - v$K      # regressores por equacao: K*p + constante
  Sigma <- crossprod(U) / (v$obs - npar)
  B     <- t(chol(Sigma))
  dimnames(B) <- list(colnames(U), colnames(U))
  B
}


