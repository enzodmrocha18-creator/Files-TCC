simular <- function(v) {
  K  <- v$K
  p  <- v$p
  A  <- Bcoef(v)
  U  <- resid(v)
  Y  <- as.matrix(v$y)
  Tn <- nrow(Y)
  Ys <- matrix(0, Tn, K, dimnames = list(NULL, colnames(Y)))
  Ys[1:p, ] <- Y[1:p, ]
  sorteio <- sample(nrow(U), Tn - p, replace = TRUE)
  for (t in (p + 1):Tn) {
    x <- c(as.vector(t(Ys[(t - 1):(t - p), , drop = FALSE])), 1)
    Ys[t, ] <- A %*% x + U[sorteio[t - p], ]
  }
  ts(Ys, start = start(v$y), frequency = 12)
}




